SESSION_DRIVER=memory

# Database de pruebas (servicio `db-test` de compose.yaml). El framework carga
# este fichero por encima de `.env` cuando NODE_ENV=test, que es lo que fija
# bin/test.ts, así que la batería nunca toca la base de desarrollo.
DB_HOST=127.0.0.1
DB_PORT=54411
DB_USER=flowsync
DB_PASSWORD=flowsync
DB_DATABASE=flowsync_test
